DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/reboot_the_earth
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible relay (server-side only). Set false for Chat Completions relays.
OPENAI_BASE_URL=
OPENAI_USE_RESPONSES_API=true
AI_MAX_ATTEMPTS=3
# Optional: use Gemini instead of OpenAI (takes precedence when set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
